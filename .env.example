# Kopiera till .env och fyll i. .env ligger aldrig i git.
PGPASSWORD=byt-mig
APP_API_PASSWORD=byt-mig
JWT_SECRET=byt-mig-till-minst-32-slumpmassiga-tecken

# Filer sparas på disk (volym) som standard. S3-kompatibel objektlagring: FILE_STORAGE=s3 + S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY
FILE_STORAGE=local

# catalog = yttre noden (läser in lagtext, exporterar kravpaket)
# operations = inre noden (importerar kravpaket, lokal modell)
INSTALLATION_ROLE=operations

# Adressen webbläsaren använder (för OIDC-återhopp). Mac mini via Tailscale: http://mini:8080
PUBLIC_URL=http://localhost:8080
# Första inloggade användaren blir alltid administratör; dessa blir det också
BOOTSTRAP_ADMIN_EMAILS=anders.runhem@gmail.com,fredrik@addcontext.se

# Identitet. Utveckling: Keycloak (docker compose --profile dev). Drift: Trafikverkets IdP.
OIDC_ISSUER=http://localhost:8081/realms/resiliogov
OIDC_CLIENT_ID=resiliogov-web
OIDC_CLIENT_SECRET=
# Keycloak i Compose: webbläsaren når den på KEYCLOAK_PUBLIC_URL, API-containern på den interna adressen
KEYCLOAK_PUBLIC_URL=http://localhost:8081
OIDC_INTERNAL_BASE=http://keycloak:8080

# AI. Mac mini: Ollama på värden. Linux/NVIDIA: vllm-containern (profil ai-gpu).
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Yttre noden: CLOUDFLARE_TUNNEL_TOKEN=
LLM_MODEL=mistral-small:24b
EMBED_MODEL=bge-m3

# Källdokument (PDF) för modellutvärderingen, t.ex. ~/data/docs på minin
EVAL_DOCS_DIR=./services/ai/eval/docs
